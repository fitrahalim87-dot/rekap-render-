# Buat database Redis di Upstash, lalu isi URL dan token REST dari dashboard Upstash.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# Buat nilai acak panjang. Simpan hanya sebagai environment variable server di Vercel dan notebook Colab.
PAIRING_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
